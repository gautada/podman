#!/bin/sh

set -e

echo "Starting 'podman' as headless server"
PODMAN_PORT=2375

# Connections are defined in /home/bob/.config/containers/podman-connections.json
# Volumes are TODO — see github.com/gautada/podman#40

# Start the API service (foreground, single process)
exec /usr/bin/podman system service --time 0 tcp://0.0.0.0:${PODMAN_PORT}
